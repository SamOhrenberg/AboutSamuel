{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithCorrelationId" ],
    "Properties": {
      "Application": "PortfolioApi"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "",
    "PublicReadOnly": ""
  },
  "Mcp": {
    "SiteBaseUrl": "https://aboutsamuel.com",
    "RateLimit": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "SemanticSearch": {
      "Enabled": true,
      "PerIpPerHour": 300,
      "DailyCap": 2000,
      "CacheMinutes": 60,
      "CacheMaxEntries": 1000
    }
  },
  "EmailSettings": {
    "ConnectionString": "endpoint=https://<resource>.communication.azure.com/;accesskey=<key>",
    "From": "DoNotReply@aboutsamuel.com",
    "To": ""
  },
  "ChatSettings": {
    "ToolUse": {
      "Model": "chat"
    },
    "Question": {
      "Model": "chat"
    }
  },
  "AzureOpenAI": {
    "Endpoint": "https://aboutsamuel-ai.openai.azure.com/",
    "EmbeddingDeployment": "embedding"
  },
  "AdminSettings": {
    "JwtSecret": "<openssl rand -base64 32>",
    "AdminEmail": "",
    "BaseUrl": ""
  },
  "AdminMcp": {
    "PublicBaseUrl": "https://api.aboutsamuel.com",
    "AllowedRedirectUris": [
      "https://claude.ai/api/mcp/auth_callback",
      "https://claude.com/api/mcp/auth_callback"
    ],
    "AllowLoopbackRedirects": true,
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "SessionMaxDays": 90,
    "ApprovalMinutes": 10,
    "ToolRequestsPerMinute": 300,
    "SignInsPerHour": 10,
    "OAuthRequestsPerMinute": 30,
    "PollsPerMinute": 60
  },
  "DataTransfer": {
    "AllowImport": false
  },
  "AgentService": {
    "Url": "http://localhost:8000",
    "InternalSecret": "match this secret with the secret in the python api"
  }
}
