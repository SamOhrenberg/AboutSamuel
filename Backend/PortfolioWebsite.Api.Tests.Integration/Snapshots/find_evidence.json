{
  "name": "find_evidence",
  "title": "Find evidence for requirements",
  "annotations": {
    "title": "Find evidence for requirements",
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "requirements": {
        "description": "Short requirements, one per item, for example \"Production experience with PostgreSQL\". 1 to 15 items.",
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 15
      },
      "perRequirement": {
        "description": "Matches per requirement, 1 to 3.",
        "type": "integer",
        "default": 3,
        "minimum": 1,
        "maximum": 3
      }
    },
    "required": [
      "requirements"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string"
      },
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "requirement": {
              "type": "string"
            },
            "matches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "slug": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "snippet": {
                    "type": "string"
                  },
                  "score": {
                    "type": "number"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "id",
                  "slug",
                  "title",
                  "snippet",
                  "score",
                  "url"
                ]
              }
            }
          },
          "required": [
            "requirement",
            "matches"
          ]
        }
      }
    },
    "required": [
      "mode",
      "requirements"
    ]
  }
}
